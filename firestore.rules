// Publish only after FIREBASE_SERVICE_ACCOUNT is set in Vercel and the new code is live.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Students collection — lecturers only (students use server API)
    match /students/{studentId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Courses collection — public read for check-in by ID, lecturer write
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Attendance sessions — public read for check-in by ID, lecturer write
    match /attendance_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Attendance records — scanner creates and updates with merge
    match /attendance_records/{recordId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid || resource.data.scanned_by == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid || request.resource.data.scanned_by == request.auth.uid);
    }

    // Course attendance summary (kept exactly as required)
    match /course_attendance/{courseId} {
      allow read, delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner_id == request.auth.uid
                    && request.resource.data.owner_id == request.auth.uid;
    }

    // Course registrations — lecturers only (portal uses server API)
    match /course_registrations/{regId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Academic terms & years
    match /academic_terms/{termId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    match /academic_years/{yearId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Class levels
    match /class_levels/{levelId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Announcements & Assignments — lecturers only (portal uses server API)
    match /announcements/{noticeId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // Student portal links
    match /student_portal_links/{linkId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_id == request.auth.uid) && (request.resource == null || request.resource.data.owner_id == request.auth.uid);
    }

    // User devices (device manager)
    match /user_devices/{deviceId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid) && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Student accounts — server-only (protect credentials)
    match /student_accounts/{accountId} {
      allow read, write: if false;
    }

    // Subscriptions & Payment events
    match /subscriptions/{subId} {
      allow read, write: if isSignedIn();
    }

    match /payment_events/{eventId} {
      allow read, write: if isSignedIn();
    }

    // Push subscriptions & In-app notifications — handled via server API
    match /push_subscriptions/{subId} {
      allow read, write: if false;
    }

    match /in_app_notifications/{notifId} {
      allow read, write: if false;
    }

    match /notification_preferences/{prefId} {
      allow read, write: if false;
    }
  }
}
