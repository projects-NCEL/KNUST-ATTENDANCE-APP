rules_version = '2';

// Qmark — locked-down rules (October 2026)
//
// Who talks to the database:
//  - Lecturers: in the browser, signed in with Google (Firebase Auth). They can only
//    read and change documents they own (owner_id == their uid).
//  - Students: never directly. Everything goes through the Vercel server, which signs in
//    with a service account and is NOT subject to these rules.
//  - The public check-in page only reads one session and one course by ID.
//
// IMPORTANT: publish these only AFTER FIREBASE_SERVICE_ACCOUNT is set in Vercel and the
// new code is live, or student sign-in and check-in will stop working.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Owned by the signed-in lecturer
    function ownsExisting() {
      return isSignedIn() && resource.data.owner_id == uid();
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.owner_id == uid();
    }

    // Standard rules for a lecturer-owned collection
    function ownerRead() {
      return ownsExisting();
    }

    function ownerCreate() {
      return ownsIncoming();
    }

    function ownerUpdate() {
      return ownsExisting() && ownsIncoming();
    }

    // Default: nothing is readable or writable from a browser unless allowed below.
    // Server-only collections (student_accounts, student_portal_links, push_subscriptions,
    // in_app_notifications, notification_preferences, subscriptions, payment_events)
    // fall under this and are therefore closed to browsers.
    match /{document=**} {
      allow read, write: if false;
    }

    // Lecturer profile: only its owner
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && uid() == userId;
    }

    // Students: a lecturer's own students, plus unassigned self-registered students
    // ("universal") so lecturers can find and add them
    match /students/{studentId} {
      allow read: if isSignedIn()
        && (resource.data.owner_id == uid() || resource.data.owner_id == "universal");
      allow create: if ownerCreate();
      allow update: if isSignedIn()
        && (
          (resource.data.owner_id == uid() && request.resource.data.owner_id == uid())
          || (resource.data.owner_id == "universal"
              && request.resource.data.owner_id in [uid(), "universal"])
        );
      allow delete: if isSignedIn()
        && (resource.data.owner_id == uid() || resource.data.owner_id == "universal");
    }

    // Courses and sessions: the public check-in page may read ONE document by its ID
    match /courses/{courseId} {
      allow get: if true;
      allow list: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
      allow delete: if ownerRead();
    }

    match /attendance_sessions/{sessionId} {
      allow get: if true;
      allow list: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
      allow delete: if ownerRead();
    }

    // Lecturer-owned collections
    match /attendance_records/{recordId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    // Per-course attendance summary (used by Reports and History). The server's
    // self check-in updates it with the service account, which bypasses these rules.
    match /course_attendance/{courseId} {
      // "resource == null" lets a lecturer find out a summary doesn't exist yet,
      // so Reports can build it the first time instead of getting "permission denied"
      allow get: if isSignedIn() && (resource == null || resource.data.owner_id == uid());
      allow list, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /course_registrations/{regId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /departments/{deptId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /academic_terms/{termId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /academic_years/{yearId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /class_levels/{levelId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /announcements/{noticeId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    match /assignments/{assignmentId} {
      allow read, delete: if ownerRead();
      allow create: if ownerCreate();
      allow update: if ownerUpdate();
    }

    // Lecturer sign-in devices (device limit): only the lecturer's own devices
    match /user_devices/{deviceId} {
      allow read, delete: if isSignedIn() && resource.data.user_id == uid();
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
      allow update: if isSignedIn()
        && resource.data.user_id == uid()
        && request.resource.data.user_id == uid();
    }
  }
}
