rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Attendance sessions
    match /attendance_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Attendance records
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create: if true; // Allows students scanning QR check-in
      allow update, delete: if isSignedIn();
    }

    // Course registrations
    match /course_registrations/{regId} {
      allow read: if true;
      allow create, update, delete: if true; // Portal student registration & lecturer assignment
    }

    // Academic terms & years
    match /academic_terms/{termId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /academic_years/{yearId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Class levels
    match /class_levels/{levelId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Announcements & Assignments
    match /announcements/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Student portal links
    match /student_portal_links/{linkId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // User devices (device manager)
    match /user_devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    // Student accounts
    match /student_accounts/{accountId} {
      allow read, write: if true;
    }

    // Subscriptions & Payment events
    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /payment_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
